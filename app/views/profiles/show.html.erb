<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">My Profile</h1>
  <%= link_to "Edit profile", edit_profile_path, class: "btn btn-outline-secondary btn-sm" %>
</div>

<% if @profile.new_record? || (@profile.background_summary.blank? && @profile.key_skills.blank?) %>
  <div class="card border-0 bg-body-tertiary">
    <div class="card-body text-center py-5">
      <p class="text-muted mb-3">You haven't set up your profile yet.</p>
      <p class="text-muted small mb-4">Gemini uses your background summary and key skills to write personalized cover letters.</p>
      <%= link_to "Set up profile", edit_profile_path, class: "btn btn-primary" %>
    </div>
  </div>
<% else %>
  <div class="row g-4 mb-3">
    <div class="col-md-8">
      <div class="card h-100">
        <div class="card-header"><h6 class="mb-0">Background Summary</h6></div>
        <div class="card-body">
          <p class="mb-0" style="white-space: pre-wrap;"><%= @profile.background_summary %></p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-header"><h6 class="mb-0">Key Skills</h6></div>
        <div class="card-body">
          <p class="mb-0" style="white-space: pre-wrap;"><%= @profile.key_skills %></p>
        </div>
      </div>
    </div>
  </div>

  <% if @profile.work_history.present? %>
    <div class="card mb-3">
      <div class="card-header"><h6 class="mb-0">Work History</h6></div>
      <div class="card-body">
        <p class="mb-0" style="white-space: pre-wrap;"><%= @profile.work_history %></p>
      </div>
    </div>
  <% end %>

  <% if @profile.education.present? %>
    <div class="card mb-3">
      <div class="card-header"><h6 class="mb-0">Education</h6></div>
      <div class="card-body">
        <p class="mb-0" style="white-space: pre-wrap;"><%= @profile.education %></p>
      </div>
    </div>
  <% end %>

  <p class="text-muted small">Gemini uses this profile to personalize your cover letters and generate tailored resumes — keep it current.</p>
<% end %>
