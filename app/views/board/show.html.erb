<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">My Board</h1>
  <%= link_to "New application", new_application_path, class: "btn btn-primary btn-sm" %>
</div>

<% unless @profile_complete %>
  <div class="alert alert-warning">
    Your profile is incomplete.
    <%= link_to "Set up your profile", edit_profile_path %> so Gemini can write personalized cover letters.
  </div>
<% end %>

<div id="board">
  <%= render "board/board_columns", columns: @columns %>
</div>
