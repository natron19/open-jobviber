<div class="card mb-2"
     id="application_<%= application.id %>"
     style="border-left: 4px solid var(--accent)"
     draggable="true"
     data-id="<%= application.id %>"
     data-action="dragstart->kanban#dragstart">
  <div class="card-body p-3">
    <h6 class="card-title mb-1 fw-semibold"><%= application.job_title %></h6>
    <p class="card-text text-muted small mb-1"><%= application.company %></p>
    <% if application.applied_on %>
      <p class="card-text text-muted small mb-2">Applied <%= application.applied_on.strftime("%b %-d") %></p>
    <% end %>
    <span class="badge bg-secondary mb-2"><%= application.status.capitalize %></span>
    <div class="d-flex align-items-center gap-2 mt-2">
      <%= link_to "View", application_path(application), class: "btn btn-sm btn-outline-light" %>
      <div class="dropdown">
        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                data-bs-toggle="dropdown" aria-expanded="false">
          Move to
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          <% JobApplication::STATUSES.reject { |s| s == application.status }.each do |target_status| %>
            <li>
              <%= button_to target_status.capitalize,
                    application_path(application),
                    method: :patch,
                    params: { job_application: { status: target_status } },
                    class: "dropdown-item" %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
